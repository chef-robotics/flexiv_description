<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="enlight_robot"
    params="
    robot_type
    robot_sn
    joint_limits_parameters_file
    kinematics_parameters_file
    inertia_parameters_file
    visual_parameters_file
    arm_prefix:=''
    use_sn_prefix:=true
    load_gripper:=false
    gripper_name:='Flexiv-GN01'
    load_mounted_ft_sensor:=false
    ros2_control:=false
    rdk_control_mode:='joint_position'
    use_fake_hardware:=false
    fake_sensor_commands:=false
    add_world_link:=true
    create_base_joint:=true
    initial_positions_file:='$(find flexiv_description)/config/Enlight-L/initial_positions.yaml'
    base_xyz:='0.0 0.0 0.0'
    base_rpy:='0.0 0.0 0.0'
    ">

    <!--
      Link/joint name prefix, built from the non-empty parts of
      `arm_prefix` and (optionally) `robot_sn`, each followed by `_`.

      `use_sn_prefix:=false` drops the serial, which is what lets a
      consumer name joints `arm1_joint1..7` instead of
      `arm1_<serial>_joint1..7`. `robot_sn` still reaches the RDK
      separately (it is how the robot is addressed and must stay a real
      serial), so this only decouples the joint *names* from it.
    -->
    <xacro:property name="sn_part" value="${robot_sn if use_sn_prefix else ''}" lazy_eval="false" />
    <xacro:property name="prefix"
      value="${''.join([part + '_' for part in [arm_prefix, sn_part] if part != ''])}" />

    <xacro:property name="load_mounted_ft_sensor" value="false" />

    <xacro:if value="${load_gripper and gripper_name=='Flexiv-GN01'}">
      <xacro:include filename="$(find flexiv_description)/urdf/common/grav_macro.xacro" />
      <xacro:flexiv_GN01 prefix="${prefix}" mesh_prefix_path="package://flexiv_description/" />
    </xacro:if>

    <xacro:include filename="$(find flexiv_description)/urdf/common/enlight_arm.xacro" />
    <xacro:enlight_arm prefix="${prefix}"
      load_mounted_ft_sensor="${load_mounted_ft_sensor}"
      joint_limits_parameters_file="${joint_limits_parameters_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      inertia_parameters_file="${inertia_parameters_file}"
      visual_parameters_file="${visual_parameters_file}"
      add_world_link="${add_world_link}"
      create_base_joint="${create_base_joint}"
      base_xyz="${base_xyz}"
      base_rpy="${base_rpy}"
    />

    <xacro:if value="${ros2_control}">
      <xacro:include filename="$(find flexiv_description)/urdf/common/flexiv.ros2_control.xacro" />
      <xacro:flexiv_ros2_control prefix="${prefix}" robot_sn="${robot_sn}"
        rdk_control_mode="${rdk_control_mode}"
        use_fake_hardware="${use_fake_hardware}"
        fake_sensor_commands="${fake_sensor_commands}"
        initial_positions_file="${initial_positions_file}"
      />
    </xacro:if>

  </xacro:macro>

</robot>
