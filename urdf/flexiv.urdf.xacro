<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_type)">
  <!-- 'robot_type' values: Enlight-L (single arm), Enlight-LL (dual arm on world),
       MICO-Core (fixed torso + two Enlight-L arms),
       MICO-Plus (2-DOF pan-tilt torso + two Enlight-L arms),
       MICO-Ultra (2-DOF waist torso on mobile base + two Enlight-L arms). -->
  <xacro:arg name="robot_type" default="Enlight-L" />

  <material name="flexiv_black">
    <color rgba="0.22 0.22 0.22 1" />
  </material>

  <!-- import model macro -->
  <xacro:include filename="$(find flexiv_description)/urdf/common/enlight_robot.xacro" />

  <!-- parameters -->
  <xacro:arg name="arm_prefix" default="" />
  <!--
    Whether `robot_sn` becomes part of link/joint names. Upstream default is
    `true` (`arm1_<serial>_joint1`); `false` gives bare `arm1_joint1`, which is
    what a consumer wants when its own config, SRDF and limits name joints
    without a per-robot serial in them. `robot_sn` still reaches the RDK either
    way, since that is how the robot is addressed.
  -->
  <xacro:arg name="use_sn_prefix" default="true" />
  <xacro:arg name="robot_sn" default="" />
  <xacro:arg name="joint_limits_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/joint_limits.yaml" />
  <xacro:arg name="kinematics_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/default_kinematics.yaml" />
  <xacro:arg name="inertia_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/inertia_parameters.yaml" />
  <xacro:arg name="visual_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/visual_parameters.yaml" />
  <xacro:arg name="load_gripper" default="false" />
  <xacro:arg name="gripper_name" default="Flexiv-GN01" />
  <xacro:arg name="load_mounted_ft_sensor" default="false" />
  <!-- ros2_control related parameters -->
  <xacro:arg name="ros2_control" default="false" />
  <xacro:arg name="rdk_control_mode" default="joint_position" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="fake_sensor_commands" default="false" />
  <xacro:arg name="initial_positions_file" default="" />
  <xacro:arg name="mounting_file" default="$(find flexiv_description)/config/single_robot_mounting.yaml" />
  <xacro:arg name="dual_mounting_file" default="$(find flexiv_description)/config/dual_robot_mounting.yaml" />

  <!-- Boolean flags for dispatch -->
  <xacro:property name="is_mico_core" value="${'$(arg robot_type)' == 'MICO-Core'}" />
  <xacro:property name="is_mico_plus" value="${'$(arg robot_type)' == 'MICO-Plus'}" />
  <xacro:property name="is_mico_ultra" value="${'$(arg robot_type)' == 'MICO-Ultra'}" />
  <xacro:property name="is_mico" value="${is_mico_core or is_mico_plus or is_mico_ultra}" />
  <xacro:property name="is_enlight_ll" value="${'$(arg robot_type)' == 'Enlight-LL'}" />
  <xacro:property name="is_dual" value="${is_enlight_ll or is_mico}" />

  <!-- ============================== SINGLE ARM (Enlight-L) ============================== -->
  <xacro:unless value="${is_dual}">
    <xacro:property name="mounting" value="${xacro.load_yaml('$(arg mounting_file)')}" />
    <xacro:if value="${'$(arg initial_positions_file)' == ''}">
      <xacro:property name="resolved_initial_positions_file"
        value="$(find flexiv_description)/config/$(arg robot_type)/initial_positions.yaml" />
    </xacro:if>
    <xacro:unless value="${'$(arg initial_positions_file)' == ''}">
      <xacro:property name="resolved_initial_positions_file" value="$(arg initial_positions_file)" />
    </xacro:unless>

    <xacro:enlight_robot
      robot_type="$(arg robot_type)"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="$(arg joint_limits_parameters_file)"
      kinematics_parameters_file="$(arg kinematics_parameters_file)"
      inertia_parameters_file="$(arg inertia_parameters_file)"
      visual_parameters_file="$(arg visual_parameters_file)"
      arm_prefix="$(arg arm_prefix)"
      use_sn_prefix="$(arg use_sn_prefix)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      ros2_control="$(arg ros2_control)"
      rdk_control_mode="$(arg rdk_control_mode)"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      initial_positions_file="${resolved_initial_positions_file}"
      base_rpy="${radians(mounting['orientation']['rx'])} ${radians(mounting['orientation']['ry'])} ${radians(mounting['orientation']['rz'])}">
    </xacro:enlight_robot>
  </xacro:unless>

  <!-- ============================== DUAL ARM (Enlight-LL) ============================== -->
  <xacro:if value="${is_enlight_ll}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/flexiv_dual.ros2_control.xacro" />

    <xacro:property name="dual_mounting" value="${xacro.load_yaml('$(arg dual_mounting_file)')}" />
    <xacro:property name="left_pose" value="${dual_mounting['positions']['left']}" />
    <xacro:property name="right_pose" value="${dual_mounting['positions']['right']}" />

    <!-- Each arm of a dual-arm product is an Enlight-L: reuse its config + meshes for both arms. -->
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:property name="arm_init_positions" value="${arm_cfg}/initial_positions.yaml" />
    <!--
      Per-arm initial positions, overridable independently.

      Upstream feeds both arms the same file, so a consumer that models only one
      arm cannot seed a real start pose for it without also moving the other.
      `initial_positions_file` (the single-arm arg) applies to arm 1, and
      `initial_positions_file_arm2` to arm 2; each falls back to the vendor
      default. Only mock hardware reads these (a real arm reports its own
      joints), so this decides where a simulated arm boots.
    -->
    <xacro:arg name="initial_positions_file_arm2" default="" />
    <xacro:property name="arm1_init_positions"
      value="${'$(arg initial_positions_file)' if '$(arg initial_positions_file)' != '' else arm_init_positions}" lazy_eval="false" />
    <xacro:property name="arm2_init_positions"
      value="${'$(arg initial_positions_file_arm2)' if '$(arg initial_positions_file_arm2)' != '' else arm_init_positions}" lazy_eval="false" />

    <!-- Left arm: owns the shared world link + its base joint. ros2_control handled below. -->
    <xacro:enlight_robot
      robot_type="Enlight-L"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="${arm_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${arm_cfg}/default_kinematics.yaml"
      inertia_parameters_file="${arm_cfg}/inertia_parameters.yaml"
      visual_parameters_file="${arm_cfg}/visual_parameters.yaml"
      arm_prefix="arm1"
      use_sn_prefix="$(arg use_sn_prefix)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      ros2_control="false"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      initial_positions_file="${arm1_init_positions}"
      add_world_link="true"
      create_base_joint="true"
      base_xyz="${left_pose['x']} ${left_pose['y']} ${left_pose['z']}"
      base_rpy="${radians(left_pose['rx'])} ${radians(left_pose['ry'])} ${radians(left_pose['rz'])}">
    </xacro:enlight_robot>

    <!-- Right arm: reuses the world link created by the left arm. -->
    <xacro:enlight_robot
      robot_type="Enlight-L"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="${arm_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${arm_cfg}/default_kinematics.yaml"
      inertia_parameters_file="${arm_cfg}/inertia_parameters.yaml"
      visual_parameters_file="${arm_cfg}/visual_parameters.yaml"
      arm_prefix="arm2"
      use_sn_prefix="$(arg use_sn_prefix)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      ros2_control="false"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      initial_positions_file="${arm2_init_positions}"
      add_world_link="false"
      create_base_joint="true"
      base_xyz="${right_pose['x']} ${right_pose['y']} ${right_pose['z']}"
      base_rpy="${radians(right_pose['rx'])} ${radians(right_pose['ry'])} ${radians(right_pose['rz'])}">
    </xacro:enlight_robot>

    <!--
      Single unified ros2_control for both arms (one robot_sn, two arm
      prefixes).

      The prefixes are derived the same way `enlight_robot` builds its own, and
      MUST match it: these become the `<joint name=...>` entries inside
      `<ros2_control>`, and a name that does not exist in the link/joint tree
      leaves the controller unable to claim its interfaces. The failure is
      silent, showing up only as a controller that never reaches `active`.
      Hardcoding them (as `left_$(arg robot_sn)_`) desyncs the moment
      `arm_prefix` or `use_sn_prefix` changes.

      THE MACRO'S `_left`/`_right` ARGUMENTS DO NOT NAME SIDES. The hardware
      interface binds them POSITIONALLY: it builds
      `arm_prefixes = [prefix_left, prefix_right]` and maps that list onto the
      RDK's `[ARM_1, ARM_2]`, joining the two by index
      (`flexiv_hardware_interface.cpp`, the `prefix_left`/`prefix_right` branch
      and `determine_active_groups`). Nothing anywhere looks a prefix up
      against a joint group by name.

      So the argument named `prefix_left` means "the prefix for whichever arm
      the robot calls ARM_1", nothing more. The RDK's own header documents
      `ARM_1` as "the 1st single arm" and `ARM_2` as "the 2nd": ordinal, with no
      side implied. `ARM_1`/`ARM_2` are fixed RDK enum values
      (`flexiv/rdk/data.hpp`) and cannot be renamed or reordered.

      WHICH PHYSICAL ARM IS `ARM_1` IS SET IN FLEXIV ELEMENTS, not here and not
      in any of this repo's code. Nothing in this stack can ask the robot which
      arm is on which side, and nothing validates the vendor's left/right
      assumption. If the arms ever come up swapped, that installation setting is
      what to check first; do not "fix" it by crossing the bindings below, which
      silently contradicts the geometry above (arm 1 is placed at `left_pose`).

      The local `prefix_arm_1`/`prefix_arm_2` aliases exist so this call site
      reads in the RDK's own terms. They are a rename at the call site only.

      TODO: rename the parameters themselves to `prefix_arm_1`/`prefix_arm_2`
      (and `initial_positions_file_arm_1`/`_arm_2`). Held off deliberately to
      keep this fork's diff against upstream small, because the names are NOT
      Enlight-LL-specific and a real rename is not local:
        - `flexiv_dual_ros2_control` (`common/flexiv_dual.ros2_control.xacro`)
          is shared with MICO-Core (`common/mico_core.xacro`).
        - `FlexivHardwareInterface` reads `prefix_left`/`prefix_right` by string
          name, so it serves MICO-Plus and MICO-Ultra through
          `common/flexiv_mico.ros2_control.xacro` as well.
      A rename therefore has to move the macro params, the C++ lookups and
      error strings, and all four MICO call sites together (~28 sites across 8
      files), or the un-renamed callers die with the "expected both prefix_left
      and prefix_right" fatal. That spans hardware we have none of and cannot
      test. Do it upstream, or behind a C++ shim that accepts both spellings.
    -->
    <xacro:if value="$(arg ros2_control)">
      <xacro:property name="ll_sn_part" value="${'$(arg robot_sn)' if '$(arg use_sn_prefix)' == 'true' else ''}" lazy_eval="false" />
      <xacro:property name="ll_prefix_arm1" value="${''.join([part + '_' for part in ['arm1', ll_sn_part] if part != ''])}" />
      <xacro:property name="ll_prefix_arm2" value="${''.join([part + '_' for part in ['arm2', ll_sn_part] if part != ''])}" />
      <!-- Aliases in the RDK's terms: slot 0 is ARM_1, slot 1 is ARM_2. -->
      <xacro:property name="prefix_arm_1" value="${ll_prefix_arm1}" />
      <xacro:property name="prefix_arm_2" value="${ll_prefix_arm2}" />
      <xacro:property name="initial_positions_file_arm_1" value="${arm1_init_positions}" />
      <xacro:property name="initial_positions_file_arm_2" value="${arm2_init_positions}" />
      <xacro:flexiv_dual_ros2_control
        prefix_left="${prefix_arm_1}"
        prefix_right="${prefix_arm_2}"
        robot_sn="$(arg robot_sn)"
        rdk_control_mode="$(arg rdk_control_mode)"
        use_fake_hardware="$(arg use_fake_hardware)"
        fake_sensor_commands="$(arg fake_sensor_commands)"
        initial_positions_file_left="${initial_positions_file_arm_1}"
        initial_positions_file_right="${initial_positions_file_arm_2}" />
    </xacro:if>
  </xacro:if>

  <!-- ============================== MICO-Core ============================== -->
  <xacro:if value="${is_mico_core}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/mico_core.xacro" />
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:mico_core
      robot_sn="$(arg robot_sn)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      ros2_control="$(arg ros2_control)"
      rdk_control_mode="$(arg rdk_control_mode)"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      arm_init_positions_file="${arm_cfg}/initial_positions.yaml"
      torso_init_positions_file="$(find flexiv_description)/config/MICO-Core/torso_initial_positions.yaml" />
  </xacro:if>

  <!-- ============================== MICO-Plus ============================== -->
  <xacro:if value="${is_mico_plus}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/mico_plus.xacro" />
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:mico_plus
      robot_sn="$(arg robot_sn)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      ros2_control="$(arg ros2_control)"
      rdk_control_mode="$(arg rdk_control_mode)"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      arm_init_positions_file="${arm_cfg}/initial_positions.yaml"
      torso_init_positions_file="$(find flexiv_description)/config/MICO-Plus/torso_initial_positions.yaml" />
  </xacro:if>

  <!-- ============================== MICO-Ultra ============================== -->
  <xacro:if value="${is_mico_ultra}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/mico_ultra.xacro" />
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:mico_ultra
      robot_sn="$(arg robot_sn)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      ros2_control="$(arg ros2_control)"
      rdk_control_mode="$(arg rdk_control_mode)"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      arm_init_positions_file="${arm_cfg}/initial_positions.yaml"
      torso_init_positions_file="$(find flexiv_description)/config/MICO-Ultra/torso_initial_positions.yaml" />
  </xacro:if>

</robot>
